{
  "name": "ozwizard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:file",
    "build:file": "node scripts/build-file.mjs",
    "animate:convective-fraction": "node scripts/build-convective-fraction-animation.mjs",
    "plot:convective-fraction-fourier": "node scripts/plot-convective-fraction-fourier.mjs",
    "plot:convective-fraction-phi31": "npm run plot:convective-fraction-fourier",
    "validate:turbulent-pressure": "node scripts/validate-turbulent-pressure.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs && playwright test",
    "test:e2e:smoke": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "2.37.3",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.7.0",
    "svgcanvas": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^25.9.3",
    "@types/svgcanvas": "2.6.1",
    "esbuild": "0.25.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
